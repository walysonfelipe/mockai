{
  "manifest_version": 3,
  "name": "__MSG_app_name__",
  "version": "0.1.0",
  "description": "__MSG_app_description__",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "contextMenus",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "storage",
    "offscreen",
    "tabCapture"
  ],
  "action": {
    "default_title": "__MSG_action_title__",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "img/icons/app/icon-16.png",
      "32": "img/icons/app/icon-32.png",
      "48": "img/icons/app/icon-48.png",
      "128": "img/icons/app/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' data: blob:"
  },
  "default_locale": "pt_BR",
  "icons": {
    "16": "img/icons/app/icon-16.png",
    "32": "img/icons/app/icon-32.png",
    "48": "img/icons/app/icon-48.png",
    "128": "img/icons/app/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "img/brand/mockai-logo.png",
        "img/icons/app/icon-48.png",
        "mockups/*.avif"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
